// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String          @id
  name           String
  email          String
  emailVerified  Boolean         @default(false)
  image          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  sessions       Session[]
  accounts       Account[]
  membros        Membro[]
  tarefasCriadas Tarefa[]        @relation("TarefaCriador")
  partes         Parte[]
  chavesPix      ChavePix[]
  assinaturasPro AssinaturaPro[]
  notificacoes   Notificacao[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum Funcao {
  dono
  membro
}

model Grupo {
  id            String         @id @default(cuid())
  nome          String
  descricao     String         @default("")
  membros       Membro[]
  tarefas       Tarefa[]
  assinaturaPro AssinaturaPro?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("grupo")
}

model Membro {
  idUser  String
  idGrupo String
  funcao  Funcao   @default(membro)
  user    User     @relation(fields: [idUser], references: [id], onDelete: Cascade)
  grupo   Grupo    @relation(fields: [idGrupo], references: [id], onDelete: Cascade)
  tarefas Tarefa[]
  partes  Parte[]

  @@id([idUser, idGrupo])
  @@index([idGrupo])
  @@map("membro")
}

enum TipoTarefa {
  comum
  contribuinte
  meta
  recorrente
}

enum StatusAndamento {
  AGENDADA
  EM_ANDAMENTO
  FINALIZADA
  ATRASADA
  CANCELADA
}

model Tarefa {
  id              String          @id @default(cuid())
  idGrupo         String
  idUser          String
  nome            String
  descricao       String          @default("")
  valorTotal      Decimal         @default(0.0) @db.Decimal(12, 2)
  dataInicio      DateTime
  dataFinal       DateTime
  tipoTarefa      TipoTarefa
  statusAndamento StatusAndamento @default(AGENDADA)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  grupo   Grupo   @relation(fields: [idGrupo], references: [id], onDelete: Cascade)
  criador User    @relation("TarefaCriador", fields: [idUser], references: [id], onDelete: Cascade)
  membro  Membro  @relation(fields: [idUser, idGrupo], references: [idUser, idGrupo], onDelete: Cascade)
  partes  Parte[]

  @@index([idGrupo])
  @@index([idUser])
  @@index([idUser, idGrupo])
  @@map("tarefa")
}

model Parte {
  id        String          @id @default(cuid())
  idUser    String
  idGrupo   String?
  idTarefa  String
  descricao String          @default("")
  valor     Decimal         @db.Decimal(12, 2)
  status    StatusAndamento @default(AGENDADA)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user   User    @relation(fields: [idUser], references: [id], onDelete: Cascade)
  membro Membro? @relation(fields: [idUser, idGrupo], references: [idUser, idGrupo], onDelete: Cascade)
  tarefa Tarefa  @relation(fields: [idTarefa], references: [id], onDelete: Cascade)

  @@index([idUser])
  @@index([idTarefa])
  @@index([idUser, idGrupo])
  @@map("parte")
}

enum TipoChave {
  telefone
  cpf
  email
  aleatoria
}

model ChavePix {
  id        String    @id @default(cuid())
  idUser    String
  tipoChave TipoChave
  chave     String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [idUser], references: [id], onDelete: Cascade)

  @@index([idUser])
  @@map("chave_pix")
}

enum CicloPlano {
  mensal
  anual
}

enum StatusAssinaturaPro {
  PENDENTE
  ATIVA
  CANCELADA
  FALHOU
}

model AssinaturaPro {
  id                     String              @id @default(cuid())
  idGrupo                String              @unique
  idUser                 String?
  ciclo                  CicloPlano
  status                 StatusAssinaturaPro @default(PENDENTE)
  valorCentavos          Int
  providerCheckoutId     String?             @unique
  providerSubscriptionId String?             @unique
  checkoutUrl            String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  grupo Grupo @relation(fields: [idGrupo], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [idUser], references: [id], onDelete: SetNull)

  @@map("assinatura_pro")
}

model EventoAbacatePay {
  id        String   @id
  evento    String
  createdAt DateTime @default(now())

  @@map("evento_abacate_pay")
}

enum TipoNotificacao {
  MEMBRO_ADICIONADO
  TAREFA_CRIADA
  COBRANCA_CRIADA
  PRAZO_PROXIMO
  PRAZO_VENCIDO
}

model Notificacao {
  id          String          @id @default(cuid())
  idUser      String
  tipo        TipoNotificacao
  titulo      String
  mensagem    String
  idGrupo     String?
  idTarefa    String?
  idParte     String?
  chaveEvento String          @unique
  lidaEm      DateTime?
  createdAt   DateTime        @default(now())

  user User @relation(fields: [idUser], references: [id], onDelete: Cascade)

  @@index([idUser, createdAt])
  @@index([idUser, lidaEm, createdAt])
  @@map("notificacao")
}
